  "bugfix": [
    {
      "id": "B01",
      "title": "耗时分位数多取了一个样本",
      "file": "agent/usage.py",
      "anchor": "    return ordered[rank - 1]",
      "mutation": "    return ordered[min(rank, len(ordered) - 1)]",
      "test": "test_week1.TestUsage.test_percentile_nearest_rank",
      "question": "耗时统计偏高：对 1 到 20 的有序样本，P95 实际取到了最大值。修复 nearest-rank 索引换算，保留空样本返回行为。"
    },
    {
      "id": "B02",
      "title": "Wiki 分页跨页遗漏一个字符",
      "file": "agent/wiki_mcp.py",
      "anchor": "\"next_offset\": end if end < len(markdown) else None,",
      "mutation": "\"next_offset\": end + 1 if end < len(markdown) else None,",
      "test": "test_week3.TestWikiMCP.test_real_stdio_tools_and_path_boundary",
      "question": "读取 Wiki 并严格沿 next_offset 取下一页时，分页拼接会漏字。修复分页指针，保证最后一页仍能通知读者已到末尾。"
    },
    {
      "id": "B03",
